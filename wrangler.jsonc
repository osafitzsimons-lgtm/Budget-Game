{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard. Yours was created as "budget-game"
  // (named after the repository), so the config uses that and Cloudflare deploys without warnings.
  "name": "budget-game",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-09",
  // Keep variables/secrets you set in the dashboard when Workers Builds redeploys.
  "keep_vars": true,
  "workers_dev": true,
  // Wrangler builds the front end (Vite → ./dist) before every deploy, preview and local dev.
  "build": {
    "command": "npm run build",
    "watch_dir": ["src/web", "src/shared", "src/parsers", "public", "index.html"]
  },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs Worker code. Everything else is a free static-asset request.
    "run_worker_first": ["/api/*"]
  },
  // No database ID needed: on the first deploy Cloudflare creates the database (named
  // "budget-game-db") and keeps it attached on every later deploy. The app creates its own tables.
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  // Branch previews get NO database and no secrets, so a preview can never read or
  // change your real data. Their /api calls fail closed with a clear message.
  "previews": {
    "vars": { "IS_PREVIEW": "true" }
  },
  "observability": { "enabled": false }
}
